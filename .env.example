# ──────────────────────────────────────────────────────────
# Feather — Environment Variables
# Copy this file to .env and fill in your keys.
# The app works WITHOUT any keys (uses mock data everywhere).
# Add keys incrementally to enable real data sources.
# ──────────────────────────────────────────────────────────

# ── Polygon.io (market data, quotes, news) ───────────────
# Free tier: 5 calls/min. Get one at https://polygon.io
# REQUIRED for: live quotes, real stock data, news
# WITHOUT: app uses mock data for watchlist, stock research, markets
VITE_POLYGON_API_KEY=

# ── Anthropic Claude (AI features) ───────────────────────
# Used server-side only. Get one at https://console.anthropic.com
# REQUIRED for: AI screener, morning brief generation, stock analysis
# WITHOUT: screener uses fuzzy mock matching, brief shows placeholder
ANTHROPIC_API_KEY=

# ── Clerk (authentication) ───────────────────────────────
# Get keys at https://dashboard.clerk.com
# REQUIRED for: real Google OAuth login, session management
# WITHOUT: app shows a mock "Sign in" button, skips real auth
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Stripe (billing) ─────────────────────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys
# REQUIRED for: checkout, subscription management, paywall
# WITHOUT: mock user gets auto-subscribed, billing UI is non-functional
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_ANNUAL_PRICE_ID=price_xxxxx

# ── Plaid (broker connection) ────────────────────────────
# Get keys at https://dashboard.plaid.com
# REQUIRED for: connecting real brokerage accounts
# WITHOUT: portfolio uses demo/paper trading tabs only
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── App Config ────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
NODE_ENV=development

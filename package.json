{
  "name": "feather",
  "version": "0.1.0",
  "private": true,
  "description": "Premium US equity research for UAE investors",
  "author": "Danish Mohd",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite & sleep 2 && electron .",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.15.0",
    "@clerk/express": "^2.0.7",
    "@stripe/stripe-js": "^4.9.0",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "lightweight-charts": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plaid-link": "^3.6.0",
    "react-router-dom": "^6.28.0",
    "react-virtuoso": "^4.12.3",
    "svix": "^1.89.0",
    "yahoo-finance2": "^3.14.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.5",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "plaid": "^28.0.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "stripe": "^17.4.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.feather.app",
    "productName": "Feather",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
